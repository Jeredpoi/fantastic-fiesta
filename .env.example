# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Путь для временных файлов (создастся автоматически)
TEMP_DIR=./tmp

# Путь к базе SQLite со статистикой
DB_PATH=./data/stats.db

# Каталог для логов (errors.log появится внутри)
LOG_DIR=./logs

# Лимит Telegram на размер файла, МБ. Через официальный API для ботов — 50.
# С локальным Bot API server (см. BOT_API_URL) можно поднять до 2000.
MAX_FILE_SIZE_MB=50

# Адрес локального telegram-bot-api server (https://github.com/tdlib/telegram-bot-api).
# Пусто = официальный api.telegram.org (лимит 50 МБ).
# Пример: BOT_API_URL=http://127.0.0.1:8081
BOT_API_URL=

# Таймаут отправки видео в Telegram, секунд (для больших файлов увеличьте)
SEND_TIMEOUT_SEC=300

# Сколько скачиваний в минуту разрешено одному пользователю
RATE_LIMIT_PER_MINUTE=3

# Сколько видео качаем одновременно (воркеров очереди)
WORKERS=2

# Максимальная длительность видео, секунд (0 = без ограничения)
MAX_DURATION_SEC=3600
